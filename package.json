{
  "name": "time-log",
  "productName": "Time Log",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop time log builder for Markdown work notes",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "package:mac": "npm run build && electron-builder --mac zip",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.3",
    "vite": "^6.0.5",
    "vitest": "^5.0.5",
    "wait-on": "^8.0.1"
  },
  "allowScripts": {
    "electron@45.0.0": true,
    "esbuild@0.25.12": true
  },
  "build": {
    "appId": "com.timelog.desktop",
    "productName": "Time Log",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "zip"
      ],
      "icon": "build/icon.png",
      "identity": "-"
    }
  }
}
